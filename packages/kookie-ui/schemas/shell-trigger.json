{
  "$ref": "#/definitions/Shell-triggerSchema",
  "definitions": {
    "Shell-triggerSchema": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "left",
            "rail",
            "panel",
            "sidebar",
            "inspector",
            "bottom"
          ],
          "description": "Which pane to drive"
        },
        "action": {
          "default": "toggle",
          "description": "Action to perform",
          "type": "string",
          "enum": [
            "toggle",
            "expand",
            "collapse"
          ]
        },
        "peekOnHover": {
          "default": false,
          "description": "Deprecated, removed in 1.0. Shows a preview of a closed pane on hover.",
          "type": "boolean"
        },
        "type": {
          "default": "button",
          "description": "The button type",
          "type": "string",
          "enum": [
            "button",
            "submit",
            "reset"
          ]
        },
        "className": {
          "description": "Additional CSS class name",
          "type": "string"
        },
        "style": {
          "description": "Inline styles",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "children": {
          "description": "Trigger content"
        },
        "aria-label": {
          "description": "ARIA label for accessibility",
          "type": "string"
        },
        "aria-labelledby": {
          "description": "ARIA labelled by reference",
          "type": "string"
        },
        "aria-describedby": {
          "description": "ARIA described by reference",
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shell-trigger Component Props",
  "description": "Props schema for the shell-trigger component in Kookie UI",
  "version": "1.0.0",
  "source": "Zod schema"
}