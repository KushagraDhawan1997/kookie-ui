{
  "$ref": "#/definitions/Shell-rootSchema",
  "definitions": {
    "Shell-rootSchema": {
      "type": "object",
      "properties": {
        "height": {
          "default": "full",
          "description": "Height of the frame. `full` is the window: 100dvh, with 100vh where dvh is not supported, and on a narrow touch screen the page scrolls. Any value other than `full` or `auto` makes the Shell contained.",
          "anyOf": [
            {
              "type": "string",
              "const": "full"
            },
            {
              "type": "string",
              "const": "auto"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "contained": {
          "default": false,
          "description": "Fills the parent instead of the window and always scrolls inside itself. An explicit `height` implies it.",
          "type": "boolean"
        },
        "size": {
          "default": "2",
          "description": "Index of the pane chrome and the Sidebar rows in it",
          "type": "string",
          "enum": [
            "1",
            "2",
            "3"
          ]
        },
        "className": {
          "description": "Additional CSS class name",
          "type": "string"
        },
        "style": {
          "description": "Inline styles",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "children": {
          "description": "The Shell parts, and anything else, rendered in order"
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shell-root Component Props",
  "description": "Props schema for the shell-root component in Kookie UI",
  "version": "1.0.0",
  "source": "Zod schema"
}
